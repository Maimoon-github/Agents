# ==============================================================================
# Autonomous Multi-Agent Social Media Architecture - Environment Configuration
# ==============================================================================
# Copy this file to .env and populate with your production credentials.
# NEVER commit the active .env file containing plaintext secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & DJANGO CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DJANGO_SECRET_KEY=change-me-to-a-secure-random-50-character-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & TASK BROKER
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://social_agent_user:secure_password@localhost:5432/social_agent_db
POSTGRES_POOL_URL=postgresql://social_agent_user:secure_password@localhost:5432/social_agent_db

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

CHROMA_PERSIST_DIRECTORY=/var/data/chromadb
QDRANT_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 3. LOCAL & CLOUD LLM INFERENCE (OLLAMA / vLLM)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
PRIMARY_LLM_MODEL=llama3.3:70b-instruct
RESEARCHER_LLM_MODEL=qwen2.5:32b-instruct
VISION_LLM_MODEL=llama3.2:11b-vision
EVALUATOR_LLM_MODEL=llama3.3:70b-instruct
PUBLISHER_LLM_MODEL=mistral-small:24b

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 4. PLATFORM AUTHENTICATION & CREDENTIALS
# ------------------------------------------------------------------------------

# --- TIKTOK (Content Posting API v2) ---
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=https://yourdomain.com/api/auth/callback/tiktok/
TIKTOK_ACCESS_TOKEN=your_short_lived_tiktok_access_token_here
TIKTOK_REFRESH_TOKEN=your_long_lived_tiktok_refresh_token_here

# --- X / TWITTER (API v2) ---
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
X_REDIRECT_URI=https://yourdomain.com/api/auth/callback/x/
X_BEARER_TOKEN=your_x_app_only_bearer_token_here
X_ACCESS_TOKEN=your_x_user_context_access_token_here
X_REFRESH_TOKEN=your_x_oauth2_refresh_token_here

# Legacy compatibility aliases for X / Twitter
TWITTER_BEARER_TOKEN=your_x_app_only_bearer_token_here
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=

# --- META GRAPH API (INSTAGRAM & FACEBOOK) ---
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=https://yourdomain.com/api/auth/callback/meta/

# --- INSTAGRAM (Instagram Graph API v22.0 / v25.0) ---
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_account_id_here

# --- FACEBOOK (Facebook Graph API v22.0 / v25.0) ---
FACEBOOK_PAGE_ACCESS_TOKEN=your_never_expiring_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# ------------------------------------------------------------------------------
# 5. MCP TOOL SERVERS & EXTERNAL SEARCH
# ------------------------------------------------------------------------------
MCP_X_CONNECTOR_URL=http://127.0.0.1:8001
MCP_INSTAGRAM_CONNECTOR_URL=http://127.0.0.1:8002
MCP_TIKTOK_CONNECTOR_URL=http://127.0.0.1:8003
MCP_FACEBOOK_CONNECTOR_URL=http://127.0.0.1:8004
MCP_WEB_SEARCH_URL=http://127.0.0.1:8005

TAVILY_API_KEY=
SERPER_API_KEY=

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
OPENTELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
